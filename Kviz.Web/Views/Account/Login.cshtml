@model LoginViewModel
@{ ViewData["Title"] = "Daxil ol"; }
<div class="auth-wrap">
    <div class="card pad-lg auth-card">
        <a class="logo logo-big" href="/" style="margin-bottom:18px" aria-label="Kvizo ana səhifə"><partial name="_Logo" /></a>
        <h1>Xoş gəldiniz 👋</h1>
        <p class="muted">Kvizlərinizi idarə etmək üçün hesabınıza daxil olun.</p>
        <form method="post" novalidate>
            <input type="hidden" asp-for="ReturnUrl" />
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert error" role="alert">@ViewData.ModelState[string.Empty]!.Errors[0].ErrorMessage</div>
            }
            <div class="field">
                <label asp-for="Email">E-poçt</label>
                <input asp-for="Email" class="input" autocomplete="email" inputmode="email" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password">Parol</label>
                <input asp-for="Password" class="input" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <label class="check" style="margin-bottom:18px"><input type="checkbox" asp-for="RememberMe" /> Məni yadda saxla</label>
            <button class="btn lg block" type="submit">Daxil ol</button>
        </form>
        <p class="center muted mt" style="margin-bottom:0">Hesabınız yoxdur? <a asp-action="Register">Qeydiyyatdan keçin</a></p>
    </div>
</div>

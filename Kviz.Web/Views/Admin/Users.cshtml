@model PagedResult<AdminUserDto>
@{
    ViewData["Title"] = "İstifadəçilər · Admin";
    string q = ViewBag.Q ?? "";
    string filter = ViewBag.Filter ?? "";
    var me = User.GetUserId();
    var back = Context.Request.Path + Context.Request.QueryString;
    string PageUrl(int p) => Url.Action("Users", "Admin", new { q, filter, page = p })!;
}
<div class="container page">
    <div class="page-head"><h1>Admin paneli</h1></div>
    <partial name="_AdminNav" />

    <form method="get" class="toolbar">
        <div class="search">
            <svg class="icon"><use href="#i-search" /></svg>
            <input class="input" name="q" value="@q" placeholder="Ad və ya e-poçt axtar…" aria-label="Axtarış" />
        </div>
        <select class="input" name="filter" style="width:auto" onchange="this.form.submit()" aria-label="Filtr">
            <option value="" selected="@(filter == "")">Hamısı</option>
            <option value="admin" selected="@(filter == "admin")">Adminlər</option>
            <option value="blocked" selected="@(filter == "blocked")">Bloklananlar</option>
        </select>
        <button class="btn" type="submit">Axtar</button>
        <button class="btn secondary" type="button" onclick="document.getElementById('dlgNew').showModal()"><svg class="icon"><use href="#i-plus" /></svg> İstifadəçi əlavə et</button>
    </form>

    <div class="table-wrap">
        <table class="t">
            <thead><tr><th>İstifadəçi</th><th>Qeydiyyat</th><th>Kviz</th><th>Oyun</th><th>Vəziyyət</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model.Items)
            {
                <tr>
                    <td style="min-width:200px"><b>@u.DisplayName</b><br /><span class="muted" style="font-size:.88rem;overflow-wrap:anywhere">@u.Email</span></td>
                    <td style="white-space:nowrap">@Ui.Local(u.CreatedAt)</td>
                    <td>@u.QuizCount</td>
                    <td>@u.GameCount</td>
                    <td>
                        @if (u.IsAdmin) { <span class="chip">Admin</span> }
                        @if (u.IsBlocked) { <span class="chip red">Bloklu</span> }
                        @if (!u.IsAdmin && !u.IsBlocked) { <span class="chip gray">İstifadəçi</span> }
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                        @if (u.Id != me)
                        {
                            <form asp-controller="Admin" asp-action="ResetPassword" asp-route-id="@u.Id" method="post" style="display:inline" data-confirm="Parol sıfırlansın?|Yeni müvəqqəti parol yaradılacaq və yalnız bir dəfə göstəriləcək.|Sıfırla">
                                <input type="hidden" name="returnUrl" value="@back" />
                                <button class="btn secondary sm" type="submit">Parolu sıfırla</button>
                            </form>
                            @if (!u.IsBlocked)
                            {
                                <form asp-controller="Admin" asp-action="SetAdmin" asp-route-id="@u.Id" method="post" style="display:inline">
                                    <input type="hidden" name="returnUrl" value="@back" /><input type="hidden" name="isAdmin" value="@((!u.IsAdmin).ToString().ToLowerInvariant())" />
                                    <button class="btn secondary sm" type="submit">@(u.IsAdmin ? "Adminlikdən çıxar" : "Admin et")</button>
                                </form>
                            }
                            @if (!u.IsAdmin)
                            {
                                <form asp-controller="Admin" asp-action="Block" asp-route-id="@u.Id" method="post" style="display:inline"
                                      data-confirm="@(u.IsBlocked ? "Blok götürülsün?|İstifadəçi yenidən daxil ola biləcək.|Götür" : "İstifadəçi bloklansın?|O, daxil ola bilməyəcək və açıq sessiyası bağlanacaq.|Blokla")">
                                    <input type="hidden" name="returnUrl" value="@back" /><input type="hidden" name="blocked" value="@((!u.IsBlocked).ToString().ToLowerInvariant())" />
                                    <button class="btn secondary sm" type="submit">@(u.IsBlocked ? "Bloku götür" : "Blokla")</button>
                                </form>
                                <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@u.Id" method="post" style="display:inline" data-confirm="İstifadəçi silinsin?|Hesab, onun bütün kvizləri, oyunları və hesabatları həmişəlik silinəcək.|Sil">
                                    <input type="hidden" name="returnUrl" value="@back" />
                                    <button class="btn ghost sm" type="submit" style="color:var(--danger)" aria-label="Sil"><svg class="icon"><use href="#i-trash" /></svg></button>
                                </form>
                            }
                        }
                        else { <span class="muted">Siz</span> }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="6" class="muted center" style="padding:30px">İstifadəçi tapılmadı.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages, (Func<int, string>)PageUrl)" />
</div>

<dialog id="dlgNew">
    <form asp-controller="Admin" asp-action="CreateUser" method="post">
        <div class="dlg-body">
            <h3>Yeni istifadəçi</h3>
            <p class="muted" style="margin-top:0">Qeydiyyat bağlı olanda hesabı siz yaradırsınız. Parolu istifadəçiyə özünüz ötürün.</p>
            <div class="field"><label for="nuName">Ad</label><input id="nuName" name="displayName" class="input" required maxlength="60" /></div>
            <div class="field"><label for="nuEmail">E-poçt (giriş adı)</label><input id="nuEmail" name="email" type="email" class="input" required /></div>
            <div class="field"><label for="nuPass">Parol</label><input id="nuPass" name="password" type="text" class="input" required minlength="6" autocomplete="off" /><div class="hint">Ən azı 6 simvol.</div></div>
            <label class="check"><input type="checkbox" name="makeAdmin" value="true" /> Administrator olsun</label>
        </div>
        <div class="dlg-actions">
            <button type="button" class="btn secondary" onclick="this.closest('dialog').close()">Ləğv et</button>
            <button type="submit" class="btn">Yarat</button>
        </div>
    </form>
</dialog>

@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="auth-wrap">
    <div class="card pad-lg center" style="max-width:520px">
        <div style="font-size:4rem;font-weight:900;color:var(--brand)">@Model.Code</div>
        <h1 style="font-size:1.8rem">@Model.Title</h1>
        <p class="muted">@Model.Message</p>
        <div class="row" style="justify-content:center">
            <a class="btn" asp-controller="Home" asp-action="Index">Ana səhifə</a>
            <a class="btn secondary" asp-controller="Library" asp-action="Index">Kvizlərə bax</a>
        </div>
    </div>
</div>
